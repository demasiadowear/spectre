# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# db backups (test data dumps)
backup_*.json
backup_*.sql

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# generated artifacts
dev-server.log
dev-regen.log
leads-*.csv

# autopilot worker (sessione WA, build demo, deps locali)
worker/node_modules/
worker/.wwebjs_auth/
worker/.wwebjs_cache/
worker/.builds/
worker/.env
worker/qr.png
worker/worker-run.log

ayrobackup-leads-*.json
worker/.worker.lock

# Artefatti dell'harness end-to-end della Factory (DB locale, screenshot,
# report): si rigenerano con `node scripts/factory-e2e/run.mjs`.
scripts/factory-e2e/out/

# Progetti Forge: dipendenze e build si rigenerano
forge-projects/*/node_modules/
forge-projects/*/dist/
# Screenshot dei cicli QA intermedi: si rigenerano, tengo solo v4 e reduced
forge-projects/*/shots-v1/
forge-projects/*/shots-v2/
forge-projects/*/shots-v3/
# Artefatti rigenerabili del sito premium
forge-projects/*/dist-autonomo/
forge-projects/*/video/
forge-projects/*/autonomo-test/
forge-projects/*/artefatto-test/
forge-projects/*/shots-autonomo/
forge-projects/*/shots-artefatto/
forge-projects/*/barberia-centrale-autonomo.html
forge-projects/*/artefatto-barberia-centrale.html
forge-projects/*/shots-r1/
forge-projects/*/shots-r2/
forge-projects/*/shots-v3a/
forge-projects/*/shots-v3b/
forge-projects/*/shots-v3c/
forge-projects/*/shots-v3d/
forge-projects/*/prove-shots/
!forge-projects/showcase-studio-dentistico/prove-shots/
forge-projects/*/rasoio-vicino.png
forge-projects/*/mobile-scroll.png

# Showcase della Factory: si versionano gli screenshot consegnati e le
# prove che hanno deciso qualcosa. Gli stati intermedi dei cicli di QA,
# i video e i file autonomi si rigenerano con un comando e peserebbero
# decine di megabyte.
forge-projects/*/shots-c1/
forge-projects/*/shots-c2/
forge-projects/*/shots-c3/
forge-projects/*/shots-c3-nojs/
forge-projects/*/shots-c3-reduced/
forge-projects/*/shots-nojs/
forge-projects/*/shots-reduced/
forge-projects/*/shots-ritagli/
forge-projects/showcase-*/*-autonomo.html
