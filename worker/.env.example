# --- DB SPECTRE (stesso Turso dell'app) ---
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=...

# --- AI (stack lock: Gemini Flash only) ---
GEMINI_API_KEY=AIza...

# --- WhatsApp ---
# Numero WA di Puccio per notifiche escalation/demo (solo cifre, con prefisso paese).
PUCCIO_WA_NUMBER=39xxxxxxxxxx
# Cartella sessione persistente whatsapp-web.js (LocalAuth).
WA_SESSION_DIR=./.wwebjs_auth

# NIENTE build demo: SPECTRE non genera siti (decisione 12/06/2026).
# Le demo le prepara Puccio fuori; il worker invia solo il link
# incollato e approvato in dashboard. Nessun token Vercel richiesto.
