# --- DB SPECTRE (stesso Turso dell'app) ---
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=...

# --- AI (stack lock: Gemini Flash only) ---
GEMINI_API_KEY=AIza...

# --- WhatsApp ---
# Numero WA di Puccio per notifiche escalation/demo (solo cifre, con prefisso paese).
PUCCIO_WA_NUMBER=39xxxxxxxxxx
# Cartella sessione persistente whatsapp-web.js (LocalAuth).
WA_SESSION_DIR=./.wwebjs_auth

# --- Build demo (Stadio 3, opzionale su questa macchina) ---
# Checkout locale di ayromex-templates-gallery (editoriale/classico/minimal/pop/mono).
TEMPLATES_GALLERY_DIR=/path/to/ayromex-templates-gallery
# Cartella di lavoro per i siti demo generati.
BUILD_WORKDIR=./.builds
# Vercel deploy (team christians-projects-7637c213).
VERCEL_TOKEN=...
VERCEL_SCOPE=christians-projects-7637c213
# Git author per eventuali commit generati.
GIT_AUTHOR_EMAIL=info@demasiadowear.com
GIT_AUTHOR_NAME=AYROMEX
