# ============================================================
# AYRO SPECTRE — environment
# Copy to `.env.local`. Everything is OPTIONAL: with nothing set,
# SPECTRE runs fully on mock data + mock AI (demo mode).
# ============================================================

# ---- Auth (NextAuth / Credentials) — single tenant ----
# Leave SPECTRE_PASSWORD EMPTY to run fully open (dev bypass: the
# "DEV MODE — NO AUTH" banner shows and every route is reachable).
# Set a password to lock SPECTRE behind the /login screen.
# Generate a secret with:  npx auth secret   (or: openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
SPECTRE_USER=puccio
SPECTRE_PASSWORD=

# ---- Turso (libSQL — optional — falls back to mock data if unset) ----
# Both must be set to enable the persistent DB; otherwise SPECTRE runs on
# mock data. Apply the schema once with:
#   turso db shell <db-name> < lib/turso/schema.sql
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-token

# ---- Google Gemini (optional — mock AI fallback if unset) ----
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ---- Lead Hunter — Google Places API (optional) ----
# Without it the Hunter runs on realistic mock businesses.
# Enable "Places API" + "Geocoding API" in Google Cloud Console.
GOOGLE_PLACES_API_KEY=

# ---- Autopilot (cron Vercel: scout + study) ----
# Vercel manda `Authorization: Bearer ${CRON_SECRET}` ai cron job.
# Senza CRON_SECRET gli endpoint /api/autopilot/scout|study restano chiusi.
# Genera con:  openssl rand -hex 32
CRON_SECRET=

# ---- Intent Scout — notifiche Telegram (optional) ----
# Notifica immediata quando lo scout intent trova un lead con score
# alto (da contattare entro 1 ora). Crea il bot con @BotFather, poi
# scrivi al bot e recupera il chat_id da /getUpdates.
# Senza queste env la notifica è disattivata (resta l'alert dashboard).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Intent Scout — Chrome locale (optional, solo dev) ----
# In locale gli scraper usano il Chrome installato; path custom qui.
# Su Vercel non serve: si usa @sparticuz/chromium.
INTENT_CHROME_PATH=

# ---- Voice / TTS — ElevenLabs (optional) ----
# Without it the voice system uses the browser SpeechSynthesis (free).
# Recognition is always the browser Web Speech API (no key needed).
ELEVENLABS_API_KEY=
# Voice id (NOT the display name). Defaults to a prebuilt male voice.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
