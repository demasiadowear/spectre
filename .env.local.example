# ============================================================
# AYRO SPECTRE — environment
# Copy to `.env.local`. Everything is OPTIONAL: with nothing set,
# SPECTRE runs fully on mock data + mock AI (demo mode).
# ============================================================

# ---- Auth (NextAuth / Credentials) — single tenant ----
# Leave SPECTRE_PASSWORD EMPTY to run fully open (dev bypass: the
# "DEV MODE — NO AUTH" banner shows and every route is reachable).
# Set a password to lock SPECTRE behind the /login screen.
# Generate a secret with:  npx auth secret   (or: openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
SPECTRE_USER=puccio
SPECTRE_PASSWORD=

# ---- Turso (libSQL — optional — falls back to mock data if unset) ----
# Both must be set to enable the persistent DB; otherwise SPECTRE runs on
# mock data. Apply the schema once with:
#   turso db shell <db-name> < lib/turso/schema.sql
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-token

# ---- Claude / Anthropic (optional — mock AI fallback if unset) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Lead Hunter — Google Maps via SerpAPI (optional) ----
# Without it the Hunter runs on realistic mock businesses.
# Get a key at https://serpapi.com
SERPAPI_KEY=

# ---- Voice / TTS — ElevenLabs (optional) ----
# Without it the voice system uses the browser SpeechSynthesis (free).
# Recognition is always the browser Web Speech API (no key needed).
ELEVENLABS_API_KEY=
# Voice id (NOT the display name). Defaults to a prebuilt male voice.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
